diff --git a/HDTTests/Battlegrounds/BattlegroundsSessionRecentGamesTest.cs b/HDTTests/Battlegrounds/BattlegroundsSessionRecentGamesTest.cs
new file mode 100644
index 00000000..21af146b
--- /dev/null
+++ b/HDTTests/Battlegrounds/BattlegroundsSessionRecentGamesTest.cs
@@ -0,0 +1,64 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Session;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using static Hearthstone_Deck_Tracker.Utility.Battlegrounds.BattlegroundsLastGames;
+
+namespace HDTTests.Battlegrounds
+{
+	[TestClass]
+	public class BattlegroundsSessionRecentGamesTest
+	{
+		[TestMethod]
+		public void GetMostRecentGames_ReturnsNewestTwentyInDisplayOrder()
+		{
+			var games = CreateGames(25, DateTime.Today.AddDays(-25));
+
+			var recentGames = BattlegroundsSessionViewModel.GetMostRecentGames(
+				games,
+				BattlegroundsSessionViewModel.RecentGamesLimit
+			);
+
+			Assert.AreEqual(20, recentGames.Count);
+			CollectionAssert.AreEqual(
+				games.Skip(5).Reverse().Select(g => g.StartTime).ToList(),
+				recentGames.Select(g => g.StartTime).ToList()
+			);
+		}
+
+		[TestMethod]
+		public void GetExpiredGames_AlwaysRetainsNewestTwenty()
+		{
+			var now = DateTime.Today;
+			var games = CreateGames(25, now.AddDays(-30));
+
+			var expiredGames = BattlegroundsSessionViewModel.GetExpiredGames(games, now);
+
+			Assert.AreEqual(5, expiredGames.Count);
+			CollectionAssert.AreEqual(
+				games.Take(5).Select(g => g.StartTime).ToList(),
+				expiredGames.Select(g => g.StartTime).ToList()
+			);
+		}
+
+		[TestMethod]
+		public void GetExpiredGames_DoesNotDeleteRecentGamesBeyondTwenty()
+		{
+			var now = DateTime.Today;
+			var games = CreateGames(25, now.AddDays(-1));
+
+			var expiredGames = BattlegroundsSessionViewModel.GetExpiredGames(games, now);
+
+			Assert.AreEqual(0, expiredGames.Count);
+		}
+
+		private static List<GameItem> CreateGames(int count, DateTime firstGameStart) =>
+			Enumerable.Range(0, count)
+				.Select(index => new GameItem
+				{
+					StartTime = firstGameStart.AddHours(index).ToString("O")
+				})
+				.ToList();
+	}
+}
